# Create a bot with Telegram's @BotFather and paste its token here.
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
# Comma-separated Telegram numeric user IDs. /id works before authorization.
ALLOWED_USER_IDS=123456789
# This is YOUR audio/subtitle label, not a value detected by AniList.
LANGUAGES=Not specified
# true also sends the original PNG document. false sends the poster photo only.
SEND_PNG=true
